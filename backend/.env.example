# 模型提供商: dashscope | openai | demo
# 当设置为 demo 或未配置 API Key 时，系统自动启用内置 SOP 规则演示引擎，无需外部 Key 即可体验完整流程
MODEL_PROVIDER=dashscope

# 阿里云百炼 DashScope 配置 (推荐 qwen-plus / qwen-turbo)
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# OpenAI 兼容接口配置 (支持 OpenAI / DeepSeek / 自建 vLLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 服务端口与数据库路径
HOST=0.0.0.0
PORT=8000
DB_PATH=./data/cs_system.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
